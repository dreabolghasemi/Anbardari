# ====================================================================
# تنظیمات متغیرهای محیطی سامانه انبارداری واحد اعلام حریق ذوب‌آهن اصفهان
# شبکه محلی ویندوز (Windows LAN / Workgroup)
# طراح و تحلیل‌گر سیستم: دکتر احسان ابوالقاسمی
# ====================================================================

# ۱. پورت و محیط اجرا
PORT=3000
NODE_ENV=production

# ۲. آدرس اتصال پایگاه داده متمرکز PostgreSQL سرور
# مثال برای سرور لوکال ویندوز:
DATABASE_URL=postgresql://postgres:password@localhost:5432/warehouse_db
DATABASE_SSL=false

# ۳. کلید امنیتی احراز هویت توکن‌های JWT
JWT_SECRET=zobahan-fire-alarm-wms-lan-secret-key-2026

# ۴. مشخصات مدیر اولیه سیستم هنگام راه‌اندازی اولیه پایگاه‌داده
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FULLNAME=دکتر احسان ابوالقاسمی

# ۵. مسیر ذخیره فایل‌ها و کاتالوگ‌های PDF (اختیاری)
DATA_DIR_PATH=./data
UPLOADS_DIR_PATH=./uploads
