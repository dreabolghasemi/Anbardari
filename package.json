    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/selfsigned": "^2.1.0",
    "autoprefixer": "^10.4.21",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4.1.14"
